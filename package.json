{
  "name": "rutaclara-villa",
  "private": true,
  "version": "0.4.0",
  "description": "RutaClara Villa — prototipo TRL 4 para el reto Mente Sana Joven (Hackathon Villavicencio 2026)",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "evidencia": "vitest run --reporter=json --outputFile=docs/evidencia/resultados-pruebas.json && node scripts/generar-reporte.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}
